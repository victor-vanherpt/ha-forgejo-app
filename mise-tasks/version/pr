#!/usr/bin/env bash
#MISE description="Print the prerelease version for a PR: <version>-pr-<number>-<commits>-<short sha>"
#USAGE arg "<number>" help="Pull request number"
#USAGE flag "--sha <sha>" help="PR head commit (default: HEAD)"
#USAGE flag "--commits <n>" help="Commits in the PR (default: counted from --base to --sha)"
#USAGE flag "--base <ref>" help="Branch the PR merges into" default="origin/main"
set -euo pipefail

# shellcheck source=mise-tasks/lib/version.sh
source "${MISE_PROJECT_ROOT}/mise-tasks/lib/version.sh"
cd "${MISE_PROJECT_ROOT}"

number=${usage_number:?}
if [[ ! "${number}" =~ ^[1-9][0-9]*$ ]]; then
  echo "Not a pull request number: ${number}" >&2
  exit 1
fi

# A full SHA is used as given (CI's shallow checkout may not contain it)
sha=${usage_sha:-HEAD}
if [[ ! "${sha}" =~ ^[0-9a-f]{40}$ ]]; then
  sha=$(git rev-parse "${sha}")
fi

# Commits in the PR, so prereleases of one PR sort in push order
commits=${usage_commits:-}
if [[ -z "${commits}" ]]; then
  commits=$(git rev-list --count "${usage_base:-origin/main}..${sha}")
fi
if [[ ! "${commits}" =~ ^[0-9]+$ ]]; then
  echo "Not a commit count: ${commits}" >&2
  exit 1
fi

# Zero-padded so prereleases also sort correctly as plain text
printf '%s-pr-%s-%03d-%s\n' "$(app_version)" "${number}" "$((10#${commits}))" "${sha:0:7}"
